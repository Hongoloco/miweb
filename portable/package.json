{
  "name": "miweb-portable",
  "version": "1.0.0",
  "description": "Sistema de gestión de OLTs Antel - Versión Portable",
  "main": "server-simple.js",
  "bin": "server-simple.js",
  "scripts": {
    "start": "node server-simple.js",
    "build-exe": "pkg . --targets win-x64 --output dist/SistemaOLT-Antel.exe",
    "dev": "node server-simple.js"
  },
  "pkg": {
    "assets": [
      "*.html",
      "*.js",
      "*.json",
      "*.css"
    ],
    "targets": [
      "win-x64"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "helmet": "^6.0.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
